{
  "enabledPlugins": {
    "modern-web-guidance@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(npx modern-web-guidance search:*)",
      "Bash(npx modern-web-guidance retrieve:*)",
      "Bash(npx modern-web-guidance list:*)",
      "Bash(npx modern-web-guidance legacy-scan:*)",
