{
  "name": "ironleaf",
  "version": "2.0.20",
  "private": true,
  "productName": "Ironleaf",
  "description": "Ironleaf: a standalone notes app. Plain Markdown notes on your PC with links, a graph and canvases, and an MCP server so any AI can connect.",
  "main": "./out/main/index.js",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node tools/patch-pi-ai.mjs && electron-vite build && node tools/build-speaker-worker.mjs && node tools/build-meaning-worker.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node tools/patch-pi-ai.mjs && electron-vite build && node tools/smoke.mjs . .smoke",
    "postinstall": "node tools/patch-pi-ai.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:fast": "node tools/test-fast.mjs",
    "notices": "node tools/third-party-notices.mjs",
    "release": "node tools/release.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "d3-force": "^3.0.1",
    "echarts": "^6.1.0",
    "jose": "6.2.17",
    "onnxruntime-web": "^1.31.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.0.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.0.0",
    "@types/d3-force": "^3.0.10",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "1.15.6",
    "@vitejs/plugin-react": "^6.3.0",
    "docx": "9.16.0",
    "electron": "^45.3.3",
    "electron-vite": "^6.0.0",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^11.17.2",
    "modern-web-guidance": "1.0.1",
    "pptxgenjs": "4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ssh2": "1.17.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  },
  "overrides": {
    "katex": "$katex",
    "lodash-es": "^4.18.0",
    "image-size": "2.1.0",
    "uuid": "11.1.1"
  }
}
